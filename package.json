    "verify": "npm run lint && npm run check && npm run test && npm run build && npm run peso"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.8",
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "astro": "7.4.12",
    "jsqr": "1.4.0",
    "typescript": "6.0.3",
    "uqr": "0.1.3",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@fontsource/barlow": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0"
  }
