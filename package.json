{
  "name": "ailow-index",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "description": "Site institucional da Ailow (ailow.com.br) com o portfólio do Pedro em formato de changelog.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
