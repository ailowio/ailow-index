# Variáveis da stack (ops/stack/index.yaml). Este arquivo é VERSIONADO: só nomes e exemplos NÃO secretos.
# No servidor, copie para /opt/ailow-index/index.env (fora do repositório, dono root, 0600) e preencha.
# Não há segredo nesta stack. A TAG não fica aqui: o deploy.sh a recebe do pipeline.

# --- Obrigatórias (o deploy aborta sem alterar a stack se faltar alguma) ---
# Nome do resolvedor ACME configurado no Traefik do host (exemplo).
CERT_RESOLVER=letsencryptresolver
# Nome da rede overlay do Traefik no host (exemplo; confira com `docker network ls`).
PROXY_NETWORK=CopelNet

# --- Opcionais (default entre parênteses) ---
# Registro da imagem (ghcr.io/ailowio)
REGISTRY=
# Entrypoint HTTPS do Traefik (websecure)
ENTRYPOINT=
# Limites do serviço (64M / 0.25)
WEB_MEM=
WEB_CPUS=
