---
import Base from "../layouts/Base.astro";
import BotaoWhatsapp from "../components/BotaoWhatsapp.astro";
import IconeApp from "../components/IconeApp.astro";
import { APPS } from "../config/apps";

// F0 (2026-11-20): a home diz o que o Pedro faz (posicionamento da ESTRATEGIA §3.1 da bancada) e tem a ação
// principal. A trava do Voltar saiu daqui (ADR 003 item 4 revisto; exceção EX-03): quem chega por link volta à origem.
---

<Base
  titulo="Pedro Fernandes"
  descricao="Digitalizei e sensorizei a minha fábrica. Agora levo isso para outras empresas, com consultoria e cursos de IA para empresários."
  classeCorpo="tela-home"
  moldura
>
  <svg slot="fundo" class="fundo-pulso" viewBox="0 0 360 96" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <path d="M0 48h120l16-32 24 64 20-48 12 16h168" vector-effect="non-scaling-stroke"></path>
    <path class="destaque" d="M0 48h120l16-32 24 64 20-48 12 16h168" vector-effect="non-scaling-stroke"></path>
  </svg>
  <div class="home">
    <section class="widget">
      <p class="dominio">Pedro Fernandes · Ailow</p>
      <h1>Digitalizei e sensorizei a minha fábrica.</h1>
      <p class="proposta">Agora levo isso para outras empresas, com consultoria e cursos de IA para empresários.</p>
      <BotaoWhatsapp origem="site" />
    </section>
    <ul class="grade-apps">
      {
        APPS.map((app, i) => (
          <li>
            <a class="app" href={app.rota} style={`--i:${i}`}>
              <span class="app-tile" style={`view-transition-name: app-${app.id}`}>
                <IconeApp id={app.id} />
              </span>
              <span class="app-rotulo">{app.rotulo}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
  <span class="gesto" aria-hidden="true"></span>
</Base>
