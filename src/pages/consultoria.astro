---
import App from "../layouts/App.astro";
import BotaoWhatsapp from "../components/BotaoWhatsapp.astro";
import { mensagemContato, MAX_RESPOSTA_RAIO_X, PERGUNTAS_RAIO_X } from "../config/contato";
import { ancoraPR, CASOS, ESCADA, ETAPAS, rotuloPR } from "../data/consultoria";
import "../styles/consultoria.css";
import "../styles/desktop/ofertas.css";

// V03 (2026-11-20, ADR 007 itens 2, 5 e 7): "Faz aqui na minha". Método em 4 etapas com a Copel como exemplo,
// a escada Aprender → Automatizar → Sistema sob medida, os casos e o raio-x de 5 perguntas.
// Textos em src/data/consultoria.ts, travados por test/v03-consultoria.test.ts (só fatos de entradas confirmadas).
// V06: o vídeo da consultoria entra aqui quando o pacote da bancada chegar (ADR 008). Até lá, nenhum slot aparece.
const ESTADO_INICIAL = mensagemContato("consultoria");
---

<App
  id="consultoria"
  tituloPagina="Consultoria sob medida para empresas"
  descricao="Consultoria sob medida: o método que usei na Copel, a minha fábrica, do diagnóstico no chão de fábrica à operação. Responda o raio-x de 5 perguntas e fale comigo no WhatsApp."
>
  <div class="consultoria">
    <section class="consultoria-topo" aria-labelledby="topo-titulo">
      <p class="sobretitulo">Consultoria sob medida</p>
      <h2 id="topo-titulo">Fiz na minha fábrica. Dá para fazer na sua.</h2>
      <p class="tese">
        Levo para a sua empresa o método que usei na Copel: do chão de fábrica ao sistema em operação.
      </p>
      <BotaoWhatsapp origem="consultoria" />
      <a class="ir-raio-x" href="#raio-x">Antes, responda 5 perguntas</a>
    </section>

    <section aria-labelledby="metodo-titulo">
      <h2 id="metodo-titulo">O método, em 4 etapas</h2>
      <ol class="metodo">
        {
          ETAPAS.map((e, i) => (
            <li>
              <span class="metodo-num" aria-hidden="true">
                {String(i + 1).padStart(2, "0")}
              </span>
              <h3>{e.nome}</h3>
              <p>{e.oQue}</p>
              <div class="na-copel">
                <p>
                  <strong>Na Copel:</strong> {e.naCopel}
                </p>
                <p class="provas-pr">
                  {e.prs.map((n) => (
                    <a href={`/pedro/#${ancoraPR(n)}`} aria-label={`Entrada ${rotuloPR(n)} do Diário de obra`}>
                      {rotuloPR(n)}
                    </a>
                  ))}
                </p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section aria-labelledby="escada-titulo">
      <h2 id="escada-titulo">Do curso ao sistema</h2>
      <p class="apoio">Três degraus. Dá para entrar em qualquer um e subir quando fizer sentido.</p>
      <ol class="escada">
        {
          ESCADA.map((d) => (
            <li class={`degrau degrau-${d.id}`}>
              <p class="degrau-oferta">{d.oferta}</p>
              <h3>{d.nome}</h3>
              <p>{d.oQue}</p>
              <a class="degrau-link" href={d.href}>
                {d.rotuloLink}
              </a>
              <p class="provas-pr">
                {d.prs.map((n) => (
                  <a href={`/pedro/#${ancoraPR(n)}`} aria-label={`Entrada ${rotuloPR(n)} do Diário de obra`}>
                    {rotuloPR(n)}
                  </a>
                ))}
              </p>
            </li>
          ))
        }
      </ol>
      <a class="escada-setor" href="/ia-no-seu-negocio">Ver usos de IA para o seu setor</a>
    </section>

    <section aria-labelledby="casos-titulo">
      <h2 id="casos-titulo">Casos</h2>
      <ul class="casos">
        {
          CASOS.map((c) => (
            <li>
              <h3>{c.nome}</h3>
              <p class="caso-papel">{c.papel}</p>
              <p>{c.texto}</p>
              {c.href && (
                <a class="degrau-link" href={c.href}>
                  {c.rotuloLink}
                </a>
              )}
              <p class="provas-pr">
                {c.prs.map((n) => (
                  <a href={`/pedro/#${ancoraPR(n)}`} aria-label={`Entrada ${rotuloPR(n)} do Diário de obra`}>
                    {rotuloPR(n)}
                  </a>
                ))}
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <section id="raio-x" aria-labelledby="raio-x-titulo">
      <h2 id="raio-x-titulo">Raio-x da sua operação</h2>
      <form class="raio-x" novalidate>
        <p class="os-cabecalho" aria-hidden="true">
          <span>Ordem de serviço</span><span>Raio-x · 5 perguntas</span>
        </p>
        {
          PERGUNTAS_RAIO_X.map((p) =>
            p.opcoes ? (
              <fieldset class="campo" role="radiogroup" aria-labelledby={`rx-${p.id}-rotulo`}>
                <legend id={`rx-${p.id}-rotulo`}>{p.pergunta}</legend>
                <div class="opcoes">
                  {p.opcoes.map((o) => (
                    <label class="opcao">
                      <input type="radio" name={p.id} value={o} />
                      <span>{o}</span>
                    </label>
                  ))}
                </div>
              </fieldset>
            ) : (
              <div class="campo">
                <label for={`rx-${p.id}`}>{p.pergunta}</label>
                {p.id === "processo" ? (
                  <textarea id={`rx-${p.id}`} name={p.id} rows="3" maxlength={MAX_RESPOSTA_RAIO_X} autocomplete="off" />
                ) : (
                  <input
                    id={`rx-${p.id}`}
                    name={p.id}
                    type="text"
                    maxlength={MAX_RESPOSTA_RAIO_X}
                    autocomplete="off"
                    placeholder="Ex.: planilha, ERP, nenhum"
                  />
                )}
              </div>
            ),
          )
        }
        <div class="previa">
          <p class="previa-titulo" id="previa-titulo">A mensagem que vai para o WhatsApp</p>
          <p class="raio-x-previa" aria-labelledby="previa-titulo">{ESTADO_INICIAL}</p>
        </div>
        <button class="botao-acao" type="submit" disabled>
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M4 4h16v12H9l-5 4z"></path>
            <path d="M8 9h8M8 12h5"></path>
          </svg>
          Enviar pelo WhatsApp
        </button>
        <p class="aviso">
          Nada vai para um servidor e nada fica guardado: a mensagem é montada no seu aparelho e abre no seu WhatsApp,
          para você conferir antes de enviar.
        </p>
      </form>
    </section>
  </div>
</App>

<script>
  import { linkRaioX, mensagemRaioX, PERGUNTAS_RAIO_X, type RespostasRaioX } from "../config/contato";

  // V03: a mensagem é montada aqui, no aparelho; o envio só abre o wa.me. Sem rede, sem armazenamento.
  const form = document.querySelector<HTMLFormElement>("form.raio-x");
  const previa = document.querySelector<HTMLElement>(".raio-x-previa");
  const enviar = form?.querySelector<HTMLButtonElement>("button[type=submit]");
  if (form && previa && enviar) {
    const ler = (): RespostasRaioX => {
      const dados = new FormData(form);
      const r: RespostasRaioX = {};
      for (const p of PERGUNTAS_RAIO_X) {
        const v = dados.get(p.id);
        if (typeof v === "string") r[p.id] = v;
      }
      return r;
    };
    const atualizar = () => {
      previa.textContent = mensagemRaioX(ler());    };
    form.addEventListener("input", atualizar);
    form.addEventListener("change", atualizar);
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      window.location.href = linkRaioX(ler());
    });
    enviar.disabled = false;
    atualizar();
  }
</script>
