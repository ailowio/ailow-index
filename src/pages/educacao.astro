// Fora do Google enquanto é placeholder (decisão do orquestrador por delegação, 2026-11-20).
---

<App
  id="educacao"
  tituloPagina="Cursos de IA para instituições"
  descricao="Cursos de IA para empresários, para levar à sua instituição."
  indexar={false}
>
  <section class="construcao">
    <div class="faixa" aria-hidden="true"></div>
    <h2>Em construção</h2>
    <p class="oferta">Cursos de IA para empresários, para levar à sua instituição.</p>
    <p>Esta página está sendo montada. Enquanto isso, fale comigo direto.</p>
    <BotaoWhatsapp origem="educacao" />
  </section>
</App>
