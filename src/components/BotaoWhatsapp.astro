---
import { linkContato, type Origem } from "../config/contato";

interface Props {
  origem: Origem;
  classe?: string;
}

const { origem, classe } = Astro.props;
---

<a class:list={["botao-acao", classe]} href={linkContato(origem)} rel="noopener noreferrer">
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M4 4h16v12H9l-5 4z"></path>
    <path d="M8 9h8M8 12h5"></path>
  </svg>
  Falar no WhatsApp
</a>
