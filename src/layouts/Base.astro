---
import "@fontsource/barlow/latin-400.css";
import "@fontsource/barlow/latin-600.css";
import "@fontsource/barlow-condensed/latin-700.css";
import "@fontsource/jetbrains-mono/latin-500.css";
import "../styles/tokens.css";
import "../styles/global.css";
import "../styles/telas.css";
import BotaoTema from "../components/BotaoTema.astro";
import { SITE } from "../config/site";

interface Props {
  titulo?: string;
  descricao?: string;
  /** Todas as rotas são noindex até o deploy decidir (S12). */
  indexar?: boolean;
  /** Classe do <body>: `tela-home` ou `tela-app` (altura fixa, sem scroll de página). */
  classeCorpo?: string;
  /** Home: no desktop, a tela vira a moldura de um aparelho centralizada. */
  moldura?: boolean;
}

const { titulo, descricao, indexar = false, classeCorpo, moldura = false } = Astro.props;
const tituloPagina = titulo ? `${titulo} | ${SITE.nome}` : SITE.nome;

// Tema sem flash (ADR 003, D6): roda antes da pintura. Padrão do sistema; a escolha do usuário vence.
// localStorage pode lançar (janela privada, dados bloqueados): sempre em try/catch.
const scriptTema = `(function(){var d=document.documentElement,t;try{t=localStorage.getItem("ailow-tema")}catch(e){}if(t!=="claro"&&t!=="escuro"){t=matchMedia("(prefers-color-scheme: light)").matches?"claro":"escuro"}d.setAttribute("data-tema",t)})()`;

// Botão de tema: 1 toque troca e grava. aria-pressed = "tema claro ligado".
const scriptBotao = `(function(){var b=document.getElementById("botao-tema");if(!b)return;var d=document.documentElement;function s(){b.setAttribute("aria-pressed",d.getAttribute("data-tema")==="claro"?"true":"false")}s();b.addEventListener("click",function(){var t=d.getAttribute("data-tema")==="claro"?"escuro":"claro";d.setAttribute("data-tema",t);try{localStorage.setItem("ailow-tema",t)}catch(e){}s()})})()`;
---

<!doctype html>
<html lang={SITE.idioma} data-tema="escuro">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {!indexar && <meta name="robots" content="noindex" />}
    {descricao && <meta name="description" content={descricao} />}
    <title>{tituloPagina}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <slot name="head" />
    <script is:inline set:html={scriptTema} />
  </head>
  <body class={classeCorpo}>
    <div class:list={["tela", { aparelho: moldura }]}>
      <slot name="cabecalho">
        <header class="cabecalho">
          <a class="marca" href="/" aria-label={`${SITE.nome}, página inicial`}>
            <span class="logo" aria-hidden="true"></span>
            <span>{SITE.nome}</span>
          </a>
          <BotaoTema />
        </header>
      </slot>
      <slot name="fundo" />
      <main class="conteudo" id="conteudo">
        <slot />
      </main>
    </div>
    <script is:inline set:html={scriptBotao} />
  </body>
</html>
